# ---- Node/React (client) ----
client/node_modules/
client/.parcel-cache/
client/.next/
client/out/
client/dist/
client/build/
client/.env
client/.env.*    # e.g. .env.local

# ---- Logs / coverage (frontend) ----
client/npm-debug.log*
client/yarn-error.log*
client/pnpm-debug.log*
client/coverage/

# ---- Misc ----
*.sqlite3
*.db
.env
.env.*
