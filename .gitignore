# ---- OS / Editor junk ----
.DS_Store
Thumbs.db
*.log
*.tmp
*.swp
*.swo
.vscode/
.idea/

# ---- Python (server) ----
server/__pycache__/
server/**/*.pyc
server/.pytest_cache/
server/.mypy_cache/
server/.coverage
server/coverage.xml
server/dist/
server/build/
server/wheels/
server/venv/
server/env/
server/.env
